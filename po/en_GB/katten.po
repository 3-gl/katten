msgid "Failed to write the API key to KWallet (error %1)."
msgstr "Failed to write the API key to KWallet (error %1)."

msgctxt "@info"
msgid "Mistral API error (%1): %2"
msgstr "Mistral API error (%1): %2"

msgctxt "@info"
msgid "Vibe returned an empty response."
msgstr "Vibe returned an empty response."

